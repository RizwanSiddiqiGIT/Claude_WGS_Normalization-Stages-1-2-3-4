#==============================================================================
# WGS NORMALIZATION STAGES 1-2-3-4 CONFIGURATION
# Produces the normalized/filtered VCF consumed by downstream VEP/panel stages.
#==============================================================================

export BASE_DIR="/home/rayzw/DNA/hg38"
export DNA_ROOT="/home/rayzw/DNA"
export REF_DIR="${DNA_ROOT}/ref_genome"
export VARIANTS_DIR="${BASE_DIR}/variants_output"
export LOGS_DIR="${BASE_DIR}/logs"
export TMP_DIR="${BASE_DIR}/tmp"
export QC_DIR="${BASE_DIR}/qc"

# Reference: must match numeric/no-chr chromosome convention.
export REF_FA="${REF_DIR}/Homo_sapiens.GRCh38.dna.primary_assembly.fa"

# Stage 1 inputs/outputs.
export RAW_FASTQ_R1="${BASE_DIR}/fastq/R1.fastq.gz"
export RAW_FASTQ_R2="${BASE_DIR}/fastq/R2.fastq.gz"
export TRIMMED_FASTQ_R1="${BASE_DIR}/fastq/R1_trimmed.fastq.gz"
export TRIMMED_FASTQ_R2="${BASE_DIR}/fastq/R2_trimmed.fastq.gz"

# Stage 2 outputs.
export READ_GROUP='@RG\tID:Rizwan\tSM:Rizwan\tPL:MGI\tLB:lib1'
export SORTED_BAM="${BASE_DIR}/Rizwan_sorted.bam"
export PROCESSED_BAM="${BASE_DIR}/Rizwan_processed.bam"
export DUP_METRICS="${BASE_DIR}/dup_metrics.txt"

# Stage 3 DeepVariant outputs.
export DEEPVARIANT_IMAGE="google/deepvariant:1.6.0"
export DEEPVARIANT_SHARDS=24
export DEEPVARIANT_CPUS=20
export MAKE_EXAMPLES_PATTERN="${VARIANTS_DIR}/make_examples.tfrecord@${DEEPVARIANT_SHARDS}.gz"
export CALLS_TFRECORD="${VARIANTS_DIR}/calls.tfrecord.gz"
export RAW_VCF="${VARIANTS_DIR}/Rizwan_raw_variants.vcf.gz"

# Stage 4 outputs.
export NORM_VCF="${VARIANTS_DIR}/Rizwan_norm.vcf.gz"
export FILTERED_VCF="${VARIANTS_DIR}/Rizwan_filtered.vcf.gz"

# Tools.
export FASTQC_BIN="${FASTQC_BIN:-fastqc}"
export MULTIQC_BIN="${MULTIQC_BIN:-multiqc}"
export FASTP_BIN="${FASTP_BIN:-fastp}"
export BWA_MEM2_BIN="${BWA_MEM2_BIN:-bwa-mem2}"
export SAMTOOLS_BIN="${SAMTOOLS_BIN:-/usr/bin/samtools}"
export BCFTOOLS_BIN="${BCFTOOLS_BIN:-/usr/bin/bcftools}"
export TABIX_BIN="${TABIX_BIN:-/usr/bin/tabix}"
export JAVA_BIN="${JAVA_BIN:-/usr/bin/java}"
export PICARD_JAR="${PICARD_JAR:-/home/rayzw/tools/picard/picard.jar}"
export DOCKER_BIN="${DOCKER_BIN:-docker}"
export PARALLEL_BIN="${PARALLEL_BIN:-parallel}"

export THREADS=24
export SORT_THREADS=16
export FASTP_THREADS=16

