#==============================================================================
# BAM INPUT PIVOT CONFIGURATION
# Use this when Stage 1 FASTQ processing is skipped because FASTQ input is
# corrupted and a pre-existing hg38 BAM is used instead.
#==============================================================================

source ./config.env

export BAM_INPUT_ROOT="/home/rayzw/DNA-Linux/hg38"
export PROCESSED_BAM="${BAM_INPUT_ROOT}/MuhammadSiddiqi-SQE38K22-30x-WGS-Sequencing_com-12-04-25.bam"
export BASE_DIR="${BAM_INPUT_ROOT}"
export VARIANTS_DIR="${BASE_DIR}/variants_output"
export LOGS_DIR="${BASE_DIR}/logs"
export TMP_DIR="${BASE_DIR}/tmp"
export QC_DIR="${BASE_DIR}/qc"

# The BAM header uses numeric/no-chr GRCh38 contigs. Use the numeric Ensembl
# primary-assembly reference for this BAM route, not the chr-prefixed NCBI
# full-plus-decoy FASTA.
export REF_FA="/home/rayzw/DNA/ref_genome/Homo_sapiens.GRCh38.dna.primary_assembly.fa"

export MAKE_EXAMPLES_PATTERN="${VARIANTS_DIR}/make_examples.tfrecord@${DEEPVARIANT_SHARDS}.gz"
export CALLS_TFRECORD="${VARIANTS_DIR}/calls.tfrecord.gz"
export RAW_VCF="${VARIANTS_DIR}/Rizwan_raw_variants.vcf.gz"
export NORM_VCF="${VARIANTS_DIR}/Rizwan_norm.vcf.gz"
export FILTERED_VCF="${VARIANTS_DIR}/Rizwan_filtered.vcf.gz"
